<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="surveillance_world">
    <!-- Geographic Datum Reference (WGS84 Reference Origin) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>44.500000</latitude_deg>
      <longitude_deg>-110.500000</longitude_deg>
      <elevation>1800.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <physics name="standard_physics" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- User Camera GUI Configuration (Oriented toward Drone Home Pad) -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-6 -10 4.5 0 0.35 1.05</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- Essential Gazebo Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Atmosphere and Sky -->
    <atmosphere type="adiabatic"/>
    
    <!-- Primary Directional Sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>50 -50 80 0 0.45 -0.8</pose>
      <diffuse>0.92 0.90 0.82 1</diffuse>
      <specular>0.3 0.3 0.25 1</specular>
      <direction>-0.45 0.35 -0.82</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Secondary Ambient Fill Light -->
    <light type="directional" name="sky_fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.25 0.30 0.38 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <!-- Main Ground Terrain with Mixed Grass & Soil -->
    <model name="main_terrain">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_col">
          <geometry><plane><normal>0 0 1</normal><size>350 350</size></plane></geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_vis">
          <geometry><plane><normal>0 0 1</normal><size>350 350</size></plane></geometry>
          <material>
            <ambient>0.28 0.38 0.22 1</ambient>
            <diffuse>0.32 0.45 0.25 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 3D Undulating Hills (Terrain Elevation) -->
    <!-- North Hill Ridge (Sector Bravo/Charlie boundary) -->
    <model name="north_ridge_hill">
      <static>true</static>
      <pose>60 75 0 0 0 0.3</pose>
      <link name="hill_link">
        <collision name="col"><geometry><cylinder><radius>35</radius><length>14</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>35</radius><length>14</length></cylinder></geometry>
          <material>
            <ambient>0.25 0.32 0.2 1</ambient>
            <diffuse>0.28 0.37 0.22 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- East Outpost Bluff (Sector Delta) -->
    <model name="east_outpost_bluff">
      <static>true</static>
      <pose>80 -25 0 0 0 -0.2</pose>
      <link name="bluff_link">
        <collision name="col"><geometry><cylinder><radius>28</radius><length>11</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>28</radius><length>11</length></cylinder></geometry>
          <material>
            <ambient>0.35 0.32 0.25 1</ambient>
            <diffuse>0.42 0.38 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West Forest Mound -->
    <model name="west_forest_mound">
      <static>true</static>
      <pose>-75 45 0 0 0 0.5</pose>
      <link name="mound_link">
        <collision name="col"><geometry><cylinder><radius>25</radius><length>8</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>25</radius><length>8</length></cylinder></geometry>
          <material>
            <ambient>0.22 0.32 0.18 1</ambient>
            <diffuse>0.25 0.38 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- River Bed and Real 3D Water Channel (Sector Charlie) -->
    <model name="river_channel">
      <static>true</static>
      <pose>0 60 0.05 0 0 0.05</pose>
      <link name="water_link">
        <collision name="water_col">
          <geometry><box><size>260 16 0.1</size></box></geometry>
        </collision>
        <visual name="water_surface">
          <geometry><box><size>260 16 0.1</size></box></geometry>
          <material>
            <ambient>0.05 0.25 0.38 0.85</ambient>
            <diffuse>0.1 0.45 0.6 0.85</diffuse>
            <specular>0.85 0.9 0.95 1</specular>
          </material>
        </visual>
        <!-- Riverbank Sand / Silt Left -->
        <visual name="riverbank_north">
          <pose>0 9 0.05 0 0 0</pose>
          <geometry><box><size>260 2.5 0.2</size></box></geometry>
          <material>
            <ambient>0.4 0.35 0.25 1</ambient>
            <diffuse>0.48 0.42 0.3 1</diffuse>
          </material>
        </visual>
        <!-- Riverbank Sand / Silt Right -->
        <visual name="riverbank_south">
          <pose>0 -9 0.05 0 0 0</pose>
          <geometry><box><size>260 2.5 0.2</size></box></geometry>
          <material>
            <ambient>0.4 0.35 0.25 1</ambient>
            <diffuse>0.48 0.42 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Concrete Truss Bridge Crossing River -->
    <model name="river_bridge">
      <static>true</static>
      <pose>0 60 0.4 0 0 1.5708</pose>
      <link name="bridge_link">
        <collision name="deck_col"><geometry><box><size>18 6 0.5</size></box></geometry></collision>
        <visual name="deck_vis">
          <geometry><box><size>18 6 0.5</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.32 1</ambient>
            <diffuse>0.4 0.4 0.42 1</diffuse>
          </material>
        </visual>
        <!-- Bridge Piers -->
        <visual name="pier_1">
          <pose>6 0 -1.0 0 0 0</pose>
          <geometry><cylinder><radius>0.6</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient></material>
        </visual>
        <visual name="pier_2">
          <pose>-6 0 -1.0 0 0 0</pose>
          <geometry><cylinder><radius>0.6</radius><length>2.0</length></cylinder></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient></material>
        </visual>
        <!-- Safety Railings -->
        <visual name="railing_left">
          <pose>0 2.8 0.6 0 0 0</pose>
          <geometry><box><size>18 0.2 0.8</size></box></geometry>
          <material><ambient>0.8 0.7 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
        <visual name="railing_right">
          <pose>0 -2.8 0.6 0 0 0</pose>
          <geometry><box><size>18 0.2 0.8</size></box></geometry>
          <material><ambient>0.8 0.7 0.1 1</ambient><diffuse>0.9 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Main Roadways -->
    <model name="main_road_north">
      <static>true</static>
      <pose>0 15 0.02 0 0 0</pose>
      <link name="road_link">
        <visual name="asphalt">
          <geometry><box><size>6 90 0.03</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.22 1</ambient>
            <diffuse>0.25 0.25 0.28 1</diffuse>
          </material>
        </visual>
        <visual name="dash_line">
          <geometry><box><size>0.2 90 0.04</size></box></geometry>
          <material>
            <ambient>0.8 0.7 0.1 1</ambient>
            <diffuse>0.9 0.8 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="camp_perimeter_road">
      <static>true</static>
      <pose>0 -25 0.02 0 0 1.5708</pose>
      <link name="road_link">
        <visual name="asphalt">
          <geometry><box><size>6 90 0.03</size></box></geometry>
          <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============================================== -->
    <!-- FICTIONAL MILITARY SURVEILLANCE CAMP           -->
    <!-- ============================================== -->

    <!-- Central Operations HQ & Mission Control -->
    <model name="ops_hq_building">
      <static>true</static>
      <pose>-15 -25 3.5 0 0 0</pose>
      <link name="building_link">
        <collision name="col"><geometry><box><size>18 12 7</size></box></geometry></collision>
        <visual name="walls">
          <geometry><box><size>18 12 7</size></box></geometry>
          <material>
            <ambient>0.4 0.42 0.45 1</ambient>
            <diffuse>0.48 0.5 0.53 1</diffuse>
          </material>
        </visual>
        <visual name="windows">
          <pose>0 -6.05 1.5 0 0 0</pose>
          <geometry><box><size>14 0.1 1.6</size></box></geometry>
          <material><ambient>0.1 0.3 0.4 0.9</ambient><diffuse>0.2 0.5 0.7 0.9</diffuse><specular>0.8 0.8 0.9 1</specular></material>
        </visual>
        <visual name="radar_dome">
          <pose>4 0 4.2 0 0 0</pose>
          <geometry><sphere><radius>1.8</radius></sphere></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="antenna_mast">
          <pose>-5 3 6.0 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>5.0</length></cylinder></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="antenna_dish">
          <pose>-5 3 7.5 0 0.4 0.6</pose>
          <geometry><cylinder><radius>1.2</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Barracks & Accommodation Building -->
    <model name="barracks_building">
      <static>true</static>
      <pose>-15 -45 2.5 0 0 0</pose>
      <link name="barracks_link">
        <collision name="col"><geometry><box><size>22 10 5</size></box></geometry></collision>
        <visual name="walls">
          <geometry><box><size>22 10 5</size></box></geometry>
          <material>
            <ambient>0.3 0.35 0.3 1</ambient>
            <diffuse>0.38 0.44 0.38 1</diffuse>
          </material>
        </visual>
        <visual name="roof">
          <pose>0 0 2.8 0 0 0</pose>
          <geometry><box><size>22.6 10.6 0.6</size></box></geometry>
          <material><ambient>0.2 0.22 0.2 1</ambient><diffuse>0.25 0.27 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Drone Hangar & Maintenance Shed -->
    <model name="drone_hangar">
      <static>true</static>
      <pose>25 -25 3.5 0 0 0</pose>
      <link name="hangar_link">
        <collision name="col"><geometry><box><size>18 16 7</size></box></geometry></collision>
        <visual name="structure">
          <geometry><box><size>18 16 7</size></box></geometry>
          <material>
            <ambient>0.35 0.36 0.38 1</ambient>
            <diffuse>0.45 0.46 0.48 1</diffuse>
          </material>
        </visual>
        <visual name="hangar_bay_door">
          <pose>0 8.05 -0.5 0 0 0</pose>
          <geometry><box><size>12 0.1 5.5</size></box></geometry>
          <material>
            <ambient>0.7 0.65 0.1 1</ambient>
            <diffuse>0.85 0.78 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Barracks Bravo & Accommodation Wing -->
    <model name="barracks_bravo_building">
      <static>true</static>
      <pose>-2 -45 2.5 0 0 0</pose>
      <link name="barracks_link">
        <collision name="col"><geometry><box><size>20 10 5</size></box></geometry></collision>
        <visual name="walls">
          <geometry><box><size>20 10 5</size></box></geometry>
          <material><ambient>0.3 0.35 0.3 1</ambient><diffuse>0.38 0.44 0.38 1</diffuse></material>
        </visual>
        <visual name="roof">
          <pose>0 0 2.8 0 0 0</pose>
          <geometry><box><size>20.6 10.6 0.6</size></box></geometry>
          <material><ambient>0.2 0.22 0.2 1</ambient><diffuse>0.25 0.27 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Base Motor Pool & Vehicle Maintenance Depot -->
    <model name="base_motor_pool">
      <static>true</static>
      <pose>25 -48 2.2 0 0 0</pose>
      <link name="pool_link">
        <collision name="col"><geometry><box><size>24 12 4.4</size></box></geometry></collision>
        <visual name="shed_roof">
          <pose>0 0 2.1 0 0 0</pose>
          <geometry><box><size>24.4 12.4 0.4</size></box></geometry>
          <material><ambient>0.25 0.28 0.32 1</ambient><diffuse>0.35 0.38 0.42 1</diffuse></material>
        </visual>
        <visual name="pillar_1"><pose>11 5 0 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>4.2</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
        <visual name="pillar_2"><pose>-11 5 0 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>4.2</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
        <visual name="pillar_3"><pose>11 -5 0 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>4.2</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
        <visual name="pillar_4"><pose>-11 -5 0 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>4.2</length></cylinder></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
    </model>

    <!-- Munitions Armory & Hardened Bunker -->
    <model name="munitions_armory_bunker">
      <static>true</static>
      <pose>-36 -28 2.0 0 0 0</pose>
      <link name="bunker_link">
        <collision name="col"><geometry><box><size>14 10 4.0</size></box></geometry></collision>
        <visual name="reinforced_walls">
          <geometry><box><size>14 10 4.0</size></box></geometry>
          <material><ambient>0.22 0.24 0.26 1</ambient><diffuse>0.30 0.32 0.35 1</diffuse></material>
        </visual>
        <visual name="blast_door">
          <pose>0 5.05 -0.2 0 0 0</pose>
          <geometry><box><size>3.5 0.2 3.0</size></box></geometry>
          <material><ambient>0.8 0.6 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Military Field Medical Station -->
    <model name="field_medical_station">
      <static>true</static>
      <pose>-36 -46 2.4 0 0 0</pose>
      <link name="med_link">
        <collision name="col"><geometry><box><size>14 10 4.8</size></box></geometry></collision>
        <visual name="walls">
          <geometry><box><size>14 10 4.8</size></box></geometry>
          <material><ambient>0.75 0.78 0.80 1</ambient><diffuse>0.85 0.88 0.90 1</diffuse></material>
        </visual>
        <visual name="red_cross_h"><pose>0 0 2.45 0 0 0</pose><geometry><box><size>4.0 1.2 0.05</size></box></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>1 0.1 0.1 1</diffuse></material></visual>
        <visual name="red_cross_v"><pose>0 0 2.45 0 0 0</pose><geometry><box><size>1.2 4.0 0.05</size></box></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>1 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Early-Warning Radar Station (Geodesic Dome on Elevated Pylon) -->
    <model name="long_range_radar_station">
      <static>true</static>
      <pose>38 -8 6.5 0 0 0</pose>
      <link name="radar_link">
        <collision name="col"><geometry><cylinder><radius>3.5</radius><length>13.0</length></cylinder></geometry></collision>
        <visual name="tower_pedestal">
          <geometry><cylinder><radius>1.8</radius><length>10.0</length></cylinder></geometry>
          <material><ambient>0.3 0.35 0.4 1</ambient><diffuse>0.4 0.45 0.5 1</diffuse></material>
        </visual>
        <visual name="geodesic_radome">
          <pose>0 0 6.2 0 0 0</pose>
          <geometry><sphere><radius>3.2</radius></sphere></geometry>
          <material><ambient>0.9 0.92 0.95 1</ambient><diffuse>0.95 0.97 1.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Fuel Storage & Refueling Facility -->
    <model name="fuel_storage_depot">
      <static>true</static>
      <pose>10 -50 2.5 0 0 0</pose>
      <link name="fuel_link">
        <visual name="tank_1"><pose>-3 0 0 0 0 0</pose><geometry><cylinder><radius>2.2</radius><length>5.0</length></cylinder></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="tank_2"><pose>3 0 0 0 0 0</pose><geometry><cylinder><radius>2.2</radius><length>5.0</length></cylinder></geometry><material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
        <visual name="hazard_band"><pose>0 0 0 0 0 0</pose><geometry><box><size>11 0.2 0.4</size></box></geometry><material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Armored Personnel Carrier (Stryker 8x8) -->
    <model name="armored_stryker_apc">
      <static>true</static>
      <pose>-18 -35 1.4 0 0 0.4</pose>
      <link name="apc_link">
        <collision name="col"><geometry><box><size>6.8 2.8 2.4</size></box></geometry></collision>
        <visual name="hull"><geometry><box><size>6.8 2.8 1.8</size></box></geometry><material><ambient>0.2 0.28 0.2 1</ambient><diffuse>0.28 0.38 0.28 1</diffuse></material></visual>
        <visual name="turret"><pose>0.8 0 1.2 0 0 0</pose><geometry><cylinder><radius>0.9</radius><length>0.8</length></cylinder></geometry><material><ambient>0.18 0.24 0.18 1</ambient></material></visual>
        <visual name="cannon"><pose>2.2 0 1.3 0 1.5708 0</pose><geometry><cylinder><radius>0.08</radius><length>2.4</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual>
      </link>
    </model>

    <!-- Main North Entry Checkpoint Guardhouse -->
    <model name="north_checkpoint_guardhouse">
      <static>true</static>
      <pose>-4.2 28 1.8 0 0 0</pose>
      <link name="gh_link">
        <collision name="col"><geometry><box><size>4.5 3.5 3.6</size></box></geometry></collision>
        <visual name="building"><geometry><box><size>4.5 3.5 3.6</size></box></geometry><material><ambient>0.3 0.35 0.32 1</ambient><diffuse>0.4 0.45 0.42 1</diffuse></material></visual>
        <visual name="observation_window"><pose>0 1.8 0.3 0 0 0</pose><geometry><box><size>3.8 0.1 1.4</size></box></geometry><material><ambient>0.1 0.3 0.4 0.8</ambient></material></visual>
      </link>
    </model>

    <!-- Dedicated Drone Landing Pad & Autonomous Charging Station (HOME STATION) -->
    <model name="drone_landing_pad_home">
      <static>true</static>
      <pose>0 0 0.12 0 0 0</pose>
      <link name="pad_link">
        <collision name="pad_col">
          <geometry><box><size>6.0 6.0 0.24</size></box></geometry>
        </collision>
        <visual name="pad_base">
          <geometry><box><size>6.0 6.0 0.24</size></box></geometry>
          <material>
            <ambient>0.22 0.22 0.25 1</ambient>
            <diffuse>0.28 0.28 0.32 1</diffuse>
          </material>
        </visual>
        <visual name="yellow_border">
          <pose>0 0 0.125 0 0 0</pose>
          <geometry><box><size>5.8 5.8 0.01</size></box></geometry>
          <material>
            <ambient>0.9 0.75 0.05 1</ambient>
            <diffuse>0.95 0.82 0.1 1</diffuse>
          </material>
        </visual>
        <visual name="inner_deck">
          <pose>0 0 0.13 0 0 0</pose>
          <geometry><box><size>5.0 5.0 0.01</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.18 1</ambient>
            <diffuse>0.18 0.18 0.22 1</diffuse>
          </material>
        </visual>
        <!-- 'H' Marking -->
        <visual name="h_bar_left">
          <pose>-0.9 0 0.135 0 0 0</pose>
          <geometry><box><size>0.45 2.6 0.01</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="h_bar_right">
          <pose>0.9 0 0.135 0 0 0</pose>
          <geometry><box><size>0.45 2.6 0.01</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="h_crossbar">
          <pose>0 0 0.135 0 0 0</pose>
          <geometry><box><size>1.8 0.45 0.01</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="charging_ring">
          <pose>0 0 0.138 0 0 0</pose>
          <geometry><cylinder><radius>1.8</radius><length>0.005</length></cylinder></geometry>
          <material>
            <ambient>0.0 0.8 0.9 0.4</ambient>
            <diffuse>0.1 0.9 1.0 0.4</diffuse>
            <emissive>0.0 0.3 0.4 1</emissive>
