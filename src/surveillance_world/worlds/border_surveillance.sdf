    <!-- World Observer Overview Camera (Panoramic Camp and Flight Theater View) -->
    <model name="world_observer_camera">
      <static>true</static>
      <pose>32.0 16.0 10.5 0 0.22 -2.67</pose>
      <link name="camera_link">
        <sensor name="world_observer_sensor" type="camera">
          <always_on>1</always_on>
          <update_rate>20</update_rate>
          <camera name="world_overview">
            <horizontal_fov>1.40</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.2</near>
              <far>400</far>
            </clip>
          </camera>
          <topic>/world/camera/overview/image_raw</topic>
        </sensor>
        <visual name="cam_housing">
          <geometry><box><size>0.4 0.25 0.25</size></box></geometry>
          <material><ambient>0.1 0.1 0.15 1</ambient><diffuse>0.2 0.2 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Autonomous Industrial Multirotor Drone on Landing Pad -->
    <include>
      <uri>/home/hari/.gemini/antigravity/scratch/surveillance_drone_ws/src/drone_description/models/surveillance_hexacopter</uri>
      <name>surveillance_drone</name>
